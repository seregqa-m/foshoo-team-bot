# Fill on the server at /etc/foshoo.env. Do not commit the filled file.
BOT_TOKEN=
ADMIN_ID=0
MINI_APP_URL=https://app.example.ru
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=sqlite:////var/lib/foshoo/theater_bot.db
GOOGLE_CALENDAR_JSON=/etc/foshoo/credentials.json
GOOGLE_CALENDAR_ID=
GOOGLE_SHEETS_ID=
GROUP_CHAT_ID=0
TIMEZONE=Europe/Moscow
SYNC_INTERVAL_MINUTES=15
LOG_LEVEL=INFO

# Stage 1: no polling, syncs, API actions, moderation or automatic sends.
RECOVERY_MODE=true
# Keep false after leaving recovery until existing polls are reconciled.
# Voter registration and attendance export retries still run outside recovery.
POLL_AUTOMATION_ENABLED=false
LLM_ENABLED=false
ASSISTANT_ENABLED=false
LLM_PROVIDER=cloudru
CLOUDRU_API_KEY=
CLOUDRU_MODEL=openai/gpt-oss-120b
LLM_MAX_TOKENS=4096
LLM_REASONING_EFFORT=

# Channel ID/@username, not discussion group ID. Empty disables moderation.
MODERATION_CHANNEL=
MODERATION_ADMIN_ID=
# Keep automatic deletion; false switches to moderator confirmation.
MODERATION_AUTO_DELETE=true

TELEGRAM_PROXY_URL=
AFISHA_NEW_DRIVE_FILE_ID=
AFISHA_OLD_DRIVE_FILE_ID=
