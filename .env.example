# Telegram Bot
BOT_TOKEN="your_bot_token_here"
# Optional: socks5://login:password@host:port or http://login:password@host:port
# Empty value uses a direct connection to Telegram.
TELEGRAM_PROXY_URL=
ADMIN_ID="your_telegram_id"
GROUP_CHAT_ID=-1000000000000

# Optional: one public channel whose comments should be checked for spam.
# @username or -100... channel ID. Empty = disabled. Do not put the discussion ID here.
MODERATION_CHANNEL=
# Private notification recipient's numeric Telegram user ID. Empty = ADMIN_ID.
# Spam is deleted automatically. Set false to require moderator confirmation.
MODERATION_AUTO_DELETE=true
MODERATION_ADMIN_ID=

# Mini App URL
MINI_APP_URL=https://app.your-domain.ru

# Google Calendar
GOOGLE_CALENDAR_JSON=backend/credentials.json
GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com
SYNC_INTERVAL_MINUTES=15

# Google Sheets
GOOGLE_SHEETS_ID=your_spreadsheet_id

# Logging
LOG_LEVEL=INFO

# Deployment: recovery blocks API actions and all background work.
RECOVERY_MODE=false
# Controls automatic sends only; voter registration/answer sync continue.
POLL_AUTOMATION_ENABLED=true

# LLM disabled by default; comment moderation uses the same provider/model.
# Without a model verdict, comments are sent for manual validation, not deleted.
LLM_ENABLED=false
ASSISTANT_ENABLED=false
# Set both flags above to true after testing the provider key.
LLM_PROVIDER=cloudru
CLOUDRU_API_KEY=
CLOUDRU_MODEL=openai/gpt-oss-120b
LLM_MAX_TOKENS=4096
LLM_REASONING_EFFORT=
# Legacy provider, used only with LLM_PROVIDER=yandex.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=b1g_your_folder_id
YANDEX_GPT_MODEL=yandexgpt/latest

# Афиша: ID файлов на Google Drive (из URL: drive.google.com/file/d/{ID}/view)
# Нужно: 1) включить Drive API в Google Cloud Console; 2) выдать сервисному аккаунту
# роль "Редактор" на обоих файлах (или на папке, где они лежат)
# При загрузке новой афиши: afisha-new → afisha-old, загруженный файл → afisha-new
AFISHA_NEW_DRIVE_FILE_ID=
AFISHA_OLD_DRIVE_FILE_ID=
