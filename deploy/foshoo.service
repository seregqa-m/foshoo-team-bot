[Unit]
Description=FoShoo API and Telegram bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=foshoo
Group=foshoo
WorkingDirectory=/opt/foshoo/backend
EnvironmentFile=/etc/foshoo.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/foshoo/.venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
